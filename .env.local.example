# ==========================================================================
# POHON DONASI INTERAKTIF BAZNAS - Environment
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# ==========================================================================

# --- Mode aplikasi ---------------------------------------------------------
# STANDALONE DEMO: jalan TANPA Firebase sama sekali (data di memori server).
# QRIS mock otomatis "berhasil". Cukup `npm run dev` untuk lihat flow penuh.
# Set "false" untuk memakai Firebase (produksi / emulator).
NEXT_PUBLIC_STANDALONE_DEMO=true

# "mock"     -> tanpa gateway asli, QRIS mock (auto-berhasil di mode demo)
# "midtrans" -> pakai Midtrans QRIS Core API (butuh kredensial di bawah)
PAYMENT_PROVIDER=mock

# Gunakan Firebase Emulator Suite (hanya relevan bila STANDALONE_DEMO=false).
# Set "true" saat menjalankan `npm run emulators`.
NEXT_PUBLIC_USE_EMULATOR=true

# --- Firebase (Client SDK) -------------------------------------------------
# Dari Firebase Console > Project settings > Your apps (Web app).
# Saat pakai emulator, cukup isi projectId yang sama dengan .firebaserc.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pohon-baznas.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pohon-baznas
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pohon-baznas.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# URL Realtime Database (channel perintah ke ESP32). Untuk emulator boleh dibiarkan.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://pohon-baznas-default-rtdb.asia-southeast1.firebasedatabase.app

# --- Firebase (Admin SDK - server only) ------------------------------------
# Untuk PRODUKSI: isi service account JSON (satu baris) ATAU set
# GOOGLE_APPLICATION_CREDENTIALS ke path file kunci.
# Untuk EMULATOR: boleh dikosongkan (cukup projectId dari client di atas).
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}

# --- Midtrans (hanya jika PAYMENT_PROVIDER=midtrans) ------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
# "true" = sandbox, "false" = production
MIDTRANS_IS_SANDBOX=true

# URL publik aplikasi (dipakai untuk callback/redirect Midtrans).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Manajemen Video Kiosk -------------------------------------------------
# Kata sandi halaman /manajemen (kelola video awal & video terima kasih).
# Default bila kosong: "baznas2024".
NEXT_PUBLIC_MANAJEMEN_PASSWORD=baznas2024

# Firebase (proyek "pohon-harapan") untuk menyimpan pengaturan video kiosk.
# Sudah ada default di kode; isi di sini hanya bila ingin memakai proyek lain.
# NEXT_PUBLIC_KIOSK_FB_API_KEY=
# NEXT_PUBLIC_KIOSK_FB_AUTH_DOMAIN=
# NEXT_PUBLIC_KIOSK_FB_PROJECT_ID=
# NEXT_PUBLIC_KIOSK_FB_STORAGE_BUCKET=
# NEXT_PUBLIC_KIOSK_FB_SENDER_ID=
# NEXT_PUBLIC_KIOSK_FB_APP_ID=

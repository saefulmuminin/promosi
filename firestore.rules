rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Admin ditandai lewat custom claim `admin: true` (di-set via Admin SDK)
      // atau minimal user yang sudah login untuk dashboard.
      return request.auth != null && request.auth.token.admin == true;
    }

    // Transaksi: dibuat & diubah HANYA oleh server (Admin SDK, bypass rules).
    // Kiosk boleh membaca status transaksinya sendiri (untuk polling QRIS).
    match /transactions/{txId} {
      allow read: if true;              // status pembayaran perlu dibaca kiosk publik
      allow create, update, delete: if false; // hanya server (Admin SDK)
    }

    // Statistik agregat: publik untuk dibaca (dashboard & layar), tulis server.
    match /stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Counter internal (nomor daun) - hanya server.
    match /counters/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Konfigurasi program (opsional, dikelola admin).
    match /programs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

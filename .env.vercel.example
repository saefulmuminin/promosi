# ==========================================================================
# ENV PRODUKSI (Vercel) — Opsi A: Firebase RTDB + ESP32 baca langsung
# Set di: Vercel > Project > Settings > Environment Variables (Production).
# Nilai NEXT_PUBLIC_* boleh publik. FIREBASE_SERVICE_ACCOUNT_KEY = RAHASIA.
# ==========================================================================

# --- Mode (WAJIB untuk keluar dari demo) -----------------------------------
NEXT_PUBLIC_STANDALONE_DEMO=false
NEXT_PUBLIC_USE_EMULATOR=false
PAYMENT_PROVIDER=mock                 # "mock" (auto-sukses) | "midtrans"

# --- Firebase Client SDK (project pohon-harapan-69dfd) ---------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAPkALtZFRO4mE9k_t36G8qtA9Su-bP2dU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pohon-harapan-69dfd.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pohon-harapan-69dfd
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pohon-harapan-69dfd.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=862282578804
NEXT_PUBLIC_FIREBASE_APP_ID=1:862282578804:web:e6c41d3ecfb3e4fd9f8a21

# GANTI setelah Realtime Database dibuat (Console > Realtime Database > salin URL).
# Formatnya tergantung region yang dipilih:
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://pohon-harapan-69dfd-default-rtdb.asia-southeast1.firebasedatabase.app

# URL publik app (dipakai redirect/callback). Isi setelah tahu domain Vercel.
NEXT_PUBLIC_APP_URL=https://GANTI-NAMA-APP.vercel.app

# Kata sandi login dashboard /manajemen (ganti dari default).
NEXT_PUBLIC_MANAJEMEN_PASSWORD=baznas2024

# --- Firebase Admin SDK (server-only, JANGAN pakai NEXT_PUBLIC_) -----------
# Console > Project settings > Service accounts > "Generate new private key".
# Salin SELURUH isi file JSON APA ADANYA jadi nilai variabel ini (biarkan \n
# di private_key seperti aslinya — jangan diubah jadi baris baru sungguhan).
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"pohon-harapan-69dfd","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@pohon-harapan-69dfd.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# --- Midtrans (hanya jika PAYMENT_PROVIDER=midtrans) -----------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_SANDBOX=true
